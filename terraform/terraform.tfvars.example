# AWS Configuration
aws_region  = "us-east-1"
environment = "dev"

# EC2 Instance Configuration
instance_type = "t3.medium"
volume_size   = 40

# Network Configuration
# Replace with your actual VPC ID
vpc_id = "vpc-0123456789abcdef0"

# Replace with your actual Subnet ID
subnet_id = "subnet-0123456789abcdef0"

# Replace with your VPC CIDR block
private_vpc_cidr = "10.0.0.0/16"

# Security Configuration
# Replace with your public IP address (get via: curl https://checkip.amazonaws.com)
admin_ip_address = "203.0.113.1"

# Optional: EKS Worker Security Group ID (leave empty if not using EKS)
eks_worker_security_group_id = ""

# Kafka Configuration
kafka_cluster_name = "kafka-cluster-dev"
kafka_broker_id    = 1

# NOTE: key_name is NO LONGER NEEDED!
# SSH keys are now automatically generated by Terraform
# See terraform/ssh-key.tf for details
